#!/bin/bash
#
# slack-demo - the Slack client on a made-up workspace, offline.
#
#   slack-demo              try it in this terminal (nothing touches Slack)
#   slack-demo record       render out/slack-demo.mp4 headless

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export UV_PROJECT_ENVIRONMENT="${XDG_DATA_HOME:-$HOME/.local/share}/petrzpav-slack/venv"
exec uv run --quiet --project "$root" python "$root/demo/demo.py" "$@"
